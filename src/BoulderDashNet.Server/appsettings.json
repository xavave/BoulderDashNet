{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AccessLog": {
    "Enabled": true,
    "Directory": "logs",
    "RetentionDays": 90
  },
  "HighScores": {
    "File": "data/highscores.json",
    "MaxEntries": 100
  }
}
