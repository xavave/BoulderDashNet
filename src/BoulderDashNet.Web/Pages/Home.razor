@page "/"
@using BoulderDashNet.Core
@using BoulderDashNet.Web.Shared

<PageTitle>Boulder Dash .NET</PageTitle>

<div class="stage">
    <div class="topbar">
        <LanguageSwitch Current="_lang" Changed="SetLanguage" />
    </div>

    <div class="screen">
        <canvas @ref="_canvas" width="640" height="416"></canvas>

        @switch (State)
        {
            case GameState.Title:
                <div class="overlay title">
                    <h1 class="logo"><span>BOULDER</span><span>DASH</span><small>.NET</small></h1>
                    <p class="tagline">@L("tagline")</p>
                    <button class="btn primary" @onclick="() => Play(0)">▶ @L("play") <kbd>@L("key.enter")</kbd></button>
                    <div class="levels">
                        <span class="label">@L("levels")</span>
                        @for (var i = 0; i < _game.LevelList.Count; i++)
                        {
                            var index = i;
                            var locked = index > _unlockedLevel;
                            <button class="lvl" disabled="@locked" title="@Texts.LevelName(_lang, _game.LevelList[index])"
                                    @onclick="() => Play(index)">@(locked ? "🔒" : (index + 1).ToString())</button>
                        }
                    </div>
                    @if (_highScore > 0)
                    {
                        <p class="hiscore">@L("highscore")@L("colon") @_highScore.ToString("000000")</p>
                    }
                </div>
                break;

            case GameState.LevelIntro when CurrentLevel is not null:
                <div class="overlay intro">
                    <div class="card">
                        <div class="lvl-num">@L("level") @(_game.LevelIndex + 1)</div>
                        <h2>@Texts.LevelName(_lang, CurrentLevel)</h2>
                        <p>@Texts.LevelHint(_lang, CurrentLevel)</p>
                        <p class="goal">💎 @CurrentLevel.DiamondsRequired @L("diamonds") · ⏱ @CurrentLevel.TimeSeconds s</p>
                    </div>
                </div>
                break;

            case GameState.Paused:
                <div class="overlay">
                    <div class="card">
                        <h2>@L("pause")</h2>
                        <button class="btn primary" @onclick="Resume">@L("resume") <kbd>@L("key.esc")</kbd></button>
                        <button class="btn" @onclick="GiveUp">@L("giveup") <kbd>R</kbd></button>
                        <button class="btn" @onclick="Menu">@L("menu")</button>
                    </div>
                </div>
                break;

            case GameState.LevelComplete:
                <div class="overlay intro">
                    <div class="card">
                        <h2>@L("levelDone")</h2>
                        <p>@L("timeBonus")@L("colon") @_game.TimeLeftSeconds</p>
                        <p class="goal">@L("score")@L("colon") @_game.Score.ToString("000000")</p>
                    </div>
                </div>
                break;

            case GameState.GameOver:
                <div class="overlay">
                    <div class="card">
                        <h2 class="danger">@L("gameOver")</h2>
                        <p class="goal">@L("score")@L("colon") @_game.Score.ToString("000000")</p>
                        <button class="btn primary" @onclick="() => Play(_game.LevelIndex)">@L("retry")</button>
                        <button class="btn" @onclick="Menu">@L("menu")</button>
                    </div>
                </div>
                break;

            case GameState.Victory:
                <div class="overlay">
                    <div class="card">
                        <h2>🏆 @L("victory")</h2>
                        <p>@L("victoryText")</p>
                        <p class="goal">@L("finalScore")@L("colon") @_game.Score.ToString("000000")</p>
                        <button class="btn primary" @onclick="Menu">@L("menu")</button>
                    </div>
                </div>
                break;
        }
    </div>

    <div class="help">
        <span><kbd>←↑→↓</kbd> / <kbd>@L("key.wasd")</kbd> @L("help.move")</span>
        <span><kbd>@L("key.space")</kbd> @L("help.snap")</span>
        <span><kbd>@L("key.esc")</kbd> @L("help.pause")</span>
        <span><kbd>M</kbd> @L("help.sound")</span>
    </div>

    <div class="touchpad" aria-hidden="true">
        <button data-dir="1" class="up">▲</button>
        <button data-dir="4" class="left">◀</button>
        <button data-dir="2" class="right">▶</button>
        <button data-dir="3" class="down">▼</button>
        <button data-key="snap" class="snap">✋</button>
        <button data-key="pause" class="pause">❚❚</button>
    </div>
</div>
